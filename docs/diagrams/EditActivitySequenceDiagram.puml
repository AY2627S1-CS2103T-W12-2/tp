@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":EditCommand" as EditCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
participant "target:Person" as Target MODEL_COLOR
participant "edited:Person" as Edited MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

[-> EditCommand : execute(m)
activate EditCommand

EditCommand -> Model : editPerson(target, edited)
activate Model

Model -> Edited : hasSameDetails(target)
activate Edited
Edited --> Model : false
deactivate Edited

Model -> Model : now()
activate Model
Model --> Model : t
deactivate Model

Model -> Target : getActivity()
activate Target
Target --> Model : activity
deactivate Target

Model -> Edited : withActivity(activity.withLastEditedAt(t))
activate Edited
Edited --> Model : stamped
deactivate Edited

Model -> Model : setPerson(target, stamped)
Model -> AddressBook : setPerson(target, stamped)
activate AddressBook
AddressBook --> Model
deactivate AddressBook

Model --> EditCommand
deactivate Model

[<-- EditCommand
deactivate EditCommand
@enduml
