@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant "r:RedoCommand" as RedoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("redo")
LogicManager -> Parser : parseCommand("redo")
create RedoCommand
Parser -> RedoCommand : new RedoCommand()
Parser --> LogicManager : r
LogicManager -> Model : createSnapshot()
Model --> LogicManager : before
LogicManager -> RedoCommand : execute(m)
RedoCommand -> Model : canRedo()

alt redo history is empty
    Model --> RedoCommand : false
    RedoCommand --> LogicManager : throws CommandException("Nothing to redo.")
    [<-- LogicManager : CommandException
else an undone state is available
    Model --> RedoCommand : true
    RedoCommand -> Model : redo()
    RedoCommand --> LogicManager : result
    LogicManager -> Model : getAddressBook()
    Model --> LogicManager : book
    LogicManager -> Storage : saveAddressBook(book)
    alt save succeeds
        Storage --> LogicManager : saved
        note right of LogicManager : Redo does not record a new mutation.
        [<-- LogicManager : result
    else save fails
        Storage --> LogicManager : throws IOException
        LogicManager -> Model : restore(before)
        note right of Model : Restore contacts and both history stacks.
        [<-- LogicManager : CommandException
    end
end

@enduml
