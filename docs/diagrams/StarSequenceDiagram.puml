@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":StarCommandParser" as StarCommandParser LOGIC_COLOR
participant "s:StarCommand" as StarCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("star 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("star 1")
activate AddressBookParser

create StarCommandParser
AddressBookParser -> StarCommandParser : StarCommandParser(true)
activate StarCommandParser

StarCommandParser --> AddressBookParser
deactivate StarCommandParser

AddressBookParser -> StarCommandParser : parse("1")
activate StarCommandParser

create StarCommand
StarCommandParser -> StarCommand : StarCommand(1, true)
activate StarCommand

StarCommand --> StarCommandParser
deactivate StarCommand

StarCommandParser --> AddressBookParser : s
deactivate StarCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
StarCommandParser -[hidden]-> AddressBookParser
destroy StarCommandParser

AddressBookParser --> LogicManager : s
deactivate AddressBookParser

LogicManager -> Model : createSnapshot()
Model --> LogicManager : before
LogicManager -> StarCommand : execute(m)
activate StarCommand

StarCommand -> Model : getFilteredPersonList()
activate Model

Model --> StarCommand : displayed list
deactivate Model

alt person's starred state differs from the requested state

    StarCommand -> Model : getViewedPerson()
    activate Model

    Model --> StarCommand : viewed person
    deactivate Model

    StarCommand -> Model : editPerson(person, starredPerson)
    activate Model

    Model --> StarCommand
    deactivate Model

    StarCommand -> Model : getViewedPerson()
    activate Model

    Model --> StarCommand : viewed person
    deactivate Model

    opt edited person was the viewed person and is no longer in the displayed list

        StarCommand -> Model : setViewedPerson(null)
        activate Model

        Model --> StarCommand
        deactivate Model

    end

else person is already in the requested state

    note right of StarCommand : No model edit or timestamp change.

end

create CommandResult
StarCommand -> CommandResult
activate CommandResult

CommandResult --> StarCommand
deactivate CommandResult

StarCommand --> LogicManager : r
deactivate StarCommand

LogicManager -> Storage : saveAddressBook(model.getAddressBook())
alt save succeeds
    Storage --> LogicManager : saved
    LogicManager -> Model : recordSuccessfulMutation(before)
    note right of Model : A no-op adds no history entry.
    [<-- LogicManager : r
else save fails
    Storage --> LogicManager : IOException
    LogicManager -> Model : restore(before)
    [<-- LogicManager : CommandException
end
deactivate LogicManager
@enduml
