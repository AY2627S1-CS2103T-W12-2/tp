@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
participant "undoHistory:Deque<State>" as UndoHistory MODEL_COLOR
participant "redoHistory:Deque<State>" as RedoHistory MODEL_COLOR
end box

[-> Model : undo()
Model -> Model : captureState()
Model --> Model : current
note right of Model : The state includes contacts, selection, filter, filter label, and sort.
Model -> UndoHistory : removeLast()
UndoHistory --> Model : previous
Model -> RedoHistory : addLast(current)
Model -> Model : restoreState(previous, true)
note right of Model
  Restore contacts, activity times, filter, sort, and selection.
  Preserve later explicit views of surviving contacts.
  No new edit or view time is stamped.
end note

@enduml
