<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <ImageView fx:id="photo" fitWidth="48" fitHeight="48" preserveRatio="true" />
      <Label fx:id="photoPlaceholder" text="No photo" minWidth="48" minHeight="48" />
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
      </HBox>
      <HBox fx:id="tags" />
      <Label fx:id="event" styleClass="cell_small_label" />
      <Label fx:id="followUp" styleClass="cell_small_label" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
      <Label fx:id="linkedIn" styleClass="cell_small_label" text="\$linkedIn" />
    </VBox>
    <Label fx:id="star" text="★" styleClass="star" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.valignment="TOP">
      <GridPane.margin>
        <Insets top="5" right="10" />
      </GridPane.margin>
    </Label>
  </GridPane>
</HBox>
